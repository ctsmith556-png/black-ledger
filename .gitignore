# ============================================================
#  Black Ledger - Unreal Engine .gitignore
#  Ignores engine-generated and build artifacts. Source,
#  Config, Content, and docs are tracked. Content binaries
#  are stored via Git LFS - see .gitattributes.
# ============================================================

# --- Unreal generated folders ---
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
!Build/.gitkeep

# --- IDEs ---
.vs/
.vscode/
.idea/
*.VC.db
*.VC.opendb
*.opensdf
*.opendb
*.sdf
*.suo
*.sln
*.user
*.userprefs
*.xcodeproj/
*.xcworkspace/
.vsconfig
Makefile
CMakeLists.txt

# --- Plugin build output (keep plugin source) ---
Plugins/**/Binaries/
Plugins/**/Intermediate/

# --- Office lock files ---
~$*

# --- Blender auto-backups ---
*.blend[0-9]

# --- Derived vehicle-prep scratch (regenerate via tools/blender/prep_vehicle.py) ---
# Keep the raw Meshy source (Name.fbx + textures), the import-ready Name_UE.fbx,
# and the prep report; drop the heavy Blender working file and preview renders.
art/source/vehicles/**/*_prep.blend
art/source/vehicles/**/*_preview_*.png

# --- OS clutter ---
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# --- Misc ---
*.log
*.tmp
*.bak
*.orig
crashes/
